NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret
DB_NAME=shop_ai_api
TEST_DB_NAME=shop_ai_api_test
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
# Required by db:seed outside production. Use local-only values; never production credentials.
SEED_ADMIN_EMAIL=local-admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe9!
SWAGGER_TITLE=Shop AI API
SWAGGER_DESCRIPTION=This is the Shop AI API
SWAGGER_VERSION=1.0.0
EMBEDDINGS_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_EMBEDDING_TIMEOUT_MS=30000
RAG_PDF_MAX_FILE_SIZE_BYTES=26214400
RAG_PDF_MAX_PAGES=500
